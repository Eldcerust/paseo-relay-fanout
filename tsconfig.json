{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["index.server.ts", "server/**/*.ts", "shared/**/*.ts", "client/view-model.ts", "test/**/*.ts"],
  "exclude": ["node_modules"]
}
